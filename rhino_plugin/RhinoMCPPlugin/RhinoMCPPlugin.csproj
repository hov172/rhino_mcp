<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>rhino-mcp</AssemblyName>
    <TargetExt>.rhp</TargetExt>
    <RootNamespace>RhinoMCPPlugin</RootNamespace>
    <Version>0.10.0</Version>
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
    <Title>rhino-mcp</Title>
    <Company>Rhino MCP Contributors</Company>
    <Description>MCP socket server plug-in for Rhino 7/8 automation.</Description>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>NU1701;CS0612</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RhinoCommon" Version="8.17.25066.7001" ExcludeAssets="runtime" />
    <PackageReference Include="Grasshopper" Version="8.17.25066.7001" ExcludeAssets="runtime" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.8.0" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="$([MSBuild]::IsOsPlatform('OSX'))">
    <Exec Command="cp &quot;$(TargetDir)rhino-mcp.rhp&quot; &quot;/Applications/Rhino 8.app/Contents/PlugIns/&quot;" ContinueOnError="true" />
  </Target>
</Project>
