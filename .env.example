# Rhino plugin connection
RHINO_MCP_HOST=host.docker.internal   # hostname where Rhino is running
RHINO_MCP_PORT=1999                   # port the Rhino plugin listens on
RHINO_MCP_BACKEND=auto                # auto | rhinocode | plugin
RHINO_MCP_PLUGIN_SECRET=              # shared secret between Rhino plugin and MCP server (required when RHINO_MCP_BIND_HOST != 127.0.0.1)

# HTTP transport (only used with --transport http)
RHINO_MCP_AUTH_TOKEN=                 # fixed bearer token for HTTP clients; unset = random token printed to stderr at startup

# Tool loading
RHMCP_PROFILE=full                    # core | grasshopper | rendering | urban | bim | full
RHMCP_COMPACT=1                       # 1 = compact mode (3 meta-tools, tools on demand); 0 = full schemas upfront

# Connection tuning (optional)
RHINO_MCP_SOCKET_TIMEOUT=10
RHINO_MCP_SOCKET_RETRIES=3
RHINO_MCP_TIMEOUT=300
RHINO_MCP_POLL_INTERVAL=0.25
RHINO_MCP_RUNPYTHON_FALLBACK=false
RHINO_MCP_TEMP_DIR=

# API keys — only required for the features that use them
ANTHROPIC_API_KEY=              # urban design language + pipeline tools
FAL_KEY=                        # AI render tools (fal.ai)
HYPER3D_API_KEY=                # Rodin 3D generation
HUNYUAN3D_API_KEY=              # HunyuanAD 3D generation
SKETCHFAB_API_KEY=              # Sketchfab model downloads
DOCRAPTOR_API_KEY=              # PDF report export

# AWS — required only for urban report S3 upload
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
URBAN_AGENT_S3_BUCKET=

# Read tool path allow-list (R7-2)
# Colon-separated list of root directories that read_* tools may access.
# Leave blank to restrict to the user's home directory only.
# Example: RHINO_MCP_READ_ROOTS=/Users/shared/projects:/Volumes/NAS/drawings
RHINO_MCP_READ_ROOTS=

# TCP keep-alive (default: enabled)
# Set to 0 to open a new connection per call (useful for debugging).
RHINO_MCP_KEEPALIVE=1

# Execution safety gates (default: all enabled)
# Set to 0 to refuse arbitrary-code execution from AI clients.
RHINO_MCP_ENABLE_RHINOSCRIPT=1  # execute_rhino_python / execute_rhinoscript_python_code
RHINO_MCP_ENABLE_CSHARP=1       # execute_rhino_csharp / execute_rhinocommon_csharp_code
RHINO_MCP_ENABLE_RUN_COMMAND=1  # run_rhino_command / run_command

# Remote host guard (default: loopback only)
# Set to 1 to allow the MCP server to connect to Rhino on a non-loopback host.
# Required when RHINO_MCP_HOST is set to a remote address (e.g. host.docker.internal).
RHINO_MCP_ALLOW_REMOTE=0

# HTTP rate limiting (requests per minute per token; HTTP transport only)
RHINO_MCP_RATE_LIMIT_RPM=120    # set to 0 to disable (not recommended)

# Asset library defaults (optional)
POLYHAVEN_RESOLUTION=2k         # 1k | 2k | 4k | 8k

# Telemetry (opt-in)
RHINO_MCP_TELEMETRY=false

# macOS installer signing and notarization
# Required to run scripts/build-installer.sh
INSTALLER_SIGNING_ID=   # Optional — auto-detected from Keychain if blank
APP_SIGNING_ID=         # Optional — auto-detected from Keychain if blank (used to sign bundled binaries)
APPLE_ID=ayala.solutions@gmail.com
APPLE_APP_PASSWORD=      # App-specific password from appleid.apple.com
APPLE_TEAM_ID=N859JA9UCJ # Found in App Store Connect > Membership
