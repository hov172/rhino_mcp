#!/usr/bin/env bash
set -euo pipefail

# Create arch-appropriate symlinks so configure always uses .venv and python
ARCH=$(uname -m)
if [ "$ARCH" = "arm64" ]; then
    ln -sfn python-arm64  /Users/Shared/rhino_mcp/python
    ln -sfn .venv-arm64   /Users/Shared/rhino_mcp/.venv
else
    ln -sfn python-x86_64 /Users/Shared/rhino_mcp/python
    ln -sfn .venv-x86_64  /Users/Shared/rhino_mcp/.venv
fi

# World-readable/executable BEFORE configure calls the venv Python
chmod -R a+rX /Users/Shared/rhino_mcp/

# Guard: plugin staging directory must exist (absent = corrupt install)
if [ ! -d "/Users/Shared/rhino_mcp/plugin" ]; then
    echo "ERROR: /Users/Shared/rhino_mcp/plugin/ not found — installation is corrupt." >&2
    exit 1
fi

# Detect the GUI user at the console (postinstall always runs as root)
CONSOLE_USER=$(stat -f "%Su" /dev/console)

# Skip on headless installs or if no user session exists
if [ -z "$CONSOLE_USER" ] || [ "$CONSOLE_USER" = "root" ]; then
    echo "No GUI session detected — run /usr/local/bin/rhino-mcp-configure" \
         "manually to configure AI clients and install the Rhino plugin." >&2
    exit 0
fi

# Run configure as the installing user; failure is non-fatal (LaunchAgent handles it)
sudo -u "$CONSOLE_USER" -H /usr/local/bin/rhino-mcp-configure || true

exit 0
