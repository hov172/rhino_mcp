#!/usr/bin/env bash
set -euo pipefail

# Block install on macOS < 13 (Ventura)
OS_VERSION=$(sw_vers -productVersion) || {
    echo "ERROR: Failed to detect macOS version" >&2
    exit 1
}
OS_MAJOR=$(echo "$OS_VERSION" | cut -d. -f1)

if ! [[ "$OS_MAJOR" =~ ^[0-9]+$ ]]; then
    echo "ERROR: Could not parse macOS version (got: $OS_VERSION)" >&2
    exit 1
fi

if [ "$OS_MAJOR" -lt 13 ]; then
    echo "ERROR: rhino-mcp requires macOS 13 Ventura or later (found $OS_VERSION)." >&2
    exit 1
fi

# Warn (do not block) if Rhino 8 is absent
if [ ! -d "/Applications/Rhino 8.app" ]; then
    echo "WARNING: Rhino 8 not found at /Applications/Rhino 8.app." >&2
    echo "         The MCP server will install but the Rhino plugin cannot load." >&2
fi

# Remove previous plugin copies so Rhino doesn't load both old and new simultaneously.
# Covers: direct copies in Plug-ins/ (Rhino 8 and 9) and Yak-installed packages.
CONSOLE_USER=$(stat -f "%Su" /dev/console 2>/dev/null || true)
if [ -n "$CONSOLE_USER" ] && [ "$CONSOLE_USER" != "root" ]; then
    USER_SUPPORT="/Users/$CONSOLE_USER/Library/Application Support/McNeel/Rhinoceros"

    for RHP in \
        "$USER_SUPPORT/7.0/Plug-ins/rhino-mcp.rhp" \
        "$USER_SUPPORT/8.0/Plug-ins/rhino-mcp.rhp" \
        "$USER_SUPPORT/9.0/Plug-ins/rhino-mcp.rhp"; do
        if [ -f "$RHP" ]; then
            rm -f "$RHP"
            echo "Removed previous plugin: $RHP"
        fi
    done

    # Yak installs a versioned subdirectory; remove all versions
    for YAK_DIR in \
        "$USER_SUPPORT/packages/7.0/rhino-mcp" \
        "$USER_SUPPORT/packages/8.0/rhino-mcp" \
        "$USER_SUPPORT/packages/9.0/rhino-mcp"; do
        if [ -d "$YAK_DIR" ]; then
            rm -rf "$YAK_DIR"
            echo "Removed Yak-installed plugin: $YAK_DIR"
        fi
    done
fi

exit 0
