#!/usr/bin/env bash
set -euo pipefail

# Block install on macOS < 13 (Ventura)
OS_VERSION=$(sw_vers -productVersion) || {
    echo "ERROR: Failed to detect macOS version" >&2
    exit 1
}
OS_MAJOR=$(echo "$OS_VERSION" | cut -d. -f1)

if ! [[ "$OS_MAJOR" =~ ^[0-9]+$ ]]; then
    echo "ERROR: Could not parse macOS version (got: $OS_VERSION)" >&2
    exit 1
fi

if [ "$OS_MAJOR" -lt 13 ]; then
    echo "ERROR: rhino-mcp requires macOS 13 Ventura or later (found $OS_VERSION)." >&2
    exit 1
fi

# Warn (do not block) if Rhino 8 is absent
if [ ! -d "/Applications/Rhino 8.app" ]; then
    echo "WARNING: Rhino 8 not found at /Applications/Rhino 8.app." >&2
    echo "         The MCP server will install but the Rhino plugin cannot load." >&2
fi

# Close Rhino before changing plugins or cached registration.
if pgrep -x Rhinoceros >/dev/null 2>&1; then
    echo "ERROR: Quit Rhino before installing rhino-mcp, then run this installer again." >&2
    exit 1
fi

# Retire application-bundle copies that would conflict with the user bundle.
for RHINO_VER in 8 9; do
    OLD_PLUGIN="/Applications/Rhino ${RHINO_VER}.app/Contents/PlugIns/rhino-mcp.rhp"
    if [ -f "$OLD_PLUGIN" ]; then
        BACKUP_DIR=$(mktemp -d /Users/Shared/rhino-mcp-legacy-plugin.XXXXXX)
        mv "$OLD_PLUGIN" "$BACKUP_DIR/rhino-mcp.rhp"
        echo "Backed up previous application plugin: $BACKUP_DIR"
    fi
done

# Per-user legacy files and cached paths are repaired by install-plugin.py.
exit 0
